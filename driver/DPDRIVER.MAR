; Bring-up breadcrumbs exposed through UCB$L_DEVDEPEND/DEVDEPND2.  They let
; SDA distinguish dispatch, buffer mapping, and command submission failures
; without logging from interrupt context.

DP_STAGE_HANDLER        = 1
DP_STAGE_MAPPED         = 2
DP_STAGE_SENT           = 3

        .IIF NDF DT$_GENERIC_SCSI, DT$_GENERIC_SCSI = 5
        .IIF NDF DPT$M_NO_IDB_DISPATCH, DPT$M_NO_IDB_DISPATCH = ^X1000
        .IIF NDF DPT$M_CSMACD, DPT$M_CSMACD = ^X8000
; The installed VAX V7.3 $DYNDEF omits the SCSI-private pool type.  The V7.3
; SCSI source listings define the SCDRP dynamic type as decimal 93.
        .IIF NDF DYN$C_SCDRP, DYN$C_SCDRP = 93
; VAX V7.3 $DYNDEF does not export generic DYN$W_SIZE/DYN$B_TYPE field
; symbols.  The local offsets above are confirmed both by the TQE listings and
; by live EXE$DEANONPAGED disassembly; their encoded operands are checked in
; the native listing.
; VAX V7.3 uses the original SCDRP flag names; later listings renamed them.
        .IIF NDF SCDRP$M_S0BUF, SCDRP$M_S0BUF = SCDRP$M_FLAG_S0BUF
        .IIF NDF SCDRP$V_S0BUF, SCDRP$V_S0BUF = SCDRP$V_FLAG_S0BUF

; Private IRP overlays used only while a SENSEMODE FDT routine owns the IRP.
IRP_L_DP_SENSE_P1       = IRP$L_IOST2
IRP_L_DP_SENSE_P2       = IRP$Q_STATION
IRP_W_DP_SENSE_P2SIZE   = IRP$Q_STATION+4
IRP_L_DP_VCI_CONTROL    = IRP$L_MEDIA

; ----- Shared controller and per-port UCB extensions --------------------
;
; There is exactly one DPCB per physical DaynaPORT target.  It owns the SPI
; connection, the serialized SCDRP, and the coroutine stack.  A template UCB
; and all future cloned protocol-port UCBs point to the same DPCB.  Clones
; must never call SPI$CONNECT or interpret their unit numbers as SCSI IDs.
;
; The two public NI pointer slots remain untouched at their VAX V7.3 offsets
; below UCB$K_LCL_DISK_LENGTH.  Private state continues after the larger SCSI
; class UCB base, not after the shorter NI extension.

        ASSUME  UCB$L_NI_HWAPTR LT UCB$K_LCL_DISK_LENGTH
        ASSUME  UCB$L_NI_MLTPTR LT UCB$K_LCL_DISK_LENGTH

        $DEFINI DPCB

$DEF    DPCB_L_MAGIC            .BLKL   1
$DEF    DPCB_L_TEMPLATE_UCB     .BLKL   1

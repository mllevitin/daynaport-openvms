        $DEFEND DPCB

        $DEFINI UCB
        .=UCB$K_LCL_DISK_LENGTH

$DEF    UCB_L_DP_CONTROLLER     .BLKL   1
$DEF    UCB_L_DP_SCDRP          .BLKL   1
$DEF    UCB_L_DP_PORT_FLAGS     .BLKL   1

$! Package the already-built V0.68 release images as a sequential PCSI kit.
$! Copyright (c) 2026 chatgpt5.6-sol and mlevitin.
$! SPDX-License-Identifier: MIT
$! This procedure never installs, loads, connects, or executes the driver.
$ SET NOON
$ ON CONTROL_Y THEN GOTO ABORTED
$ OLD_VERIFY = F$VERIFY(0)
$ PACKAGE_STATUS = 1
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DEVICE = F$PARSE(PROCEDURE,,,"DEVICE")
$ PROJECT_LOGICAL = F$EXTRACT(0,F$LENGTH(PROJECT_DEVICE)-1,PROJECT_DEVICE)
$ PHYSICAL_ROOT = F$TRNLNM(PROJECT_LOGICAL)
$ IF PHYSICAL_ROOT .EQS. "" THEN PHYSICAL_ROOT = PROJECT_DEVICE
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DIRECTORY")
$ ROOTED_DEVICE = F$EXTRACT(F$LENGTH(PHYSICAL_ROOT)-1,1,PHYSICAL_ROOT) -
                  .EQS. "]"
$ IF ROOTED_DEVICE THEN PHYSICAL_ROOT = -
      F$EXTRACT(0,F$LENGTH(PHYSICAL_ROOT)-1,PHYSICAL_ROOT)
$ IF ROOTED_DEVICE THEN PROJECT_DIR = -
      F$EXTRACT(1,F$LENGTH(PROJECT_DIR)-1,PROJECT_DIR)
$ PROJECT_ROOT = PHYSICAL_ROOT + PROJECT_DIR
$ SET DEFAULT 'PROJECT_ROOT'
$
$ IF F$SEARCH("DYDRIVER.EXE") .EQS. "" THEN GOTO NO_DRIVER
$ IF F$SEARCH("DP_VCI_CONTROL.EXE") .EQS. "" THEN GOTO NO_VCI_CONTROL
$ IF F$SEARCH("[.KIT]DAYNAPORT.PCSI$DESCRIPTION") .EQS. "" THEN -
      GOTO NO_DESCRIPTION
$ IF F$SEARCH("[.KIT]DAYNAPORT.PCSI$TEXT") .EQS. "" THEN GOTO NO_TEXT
$ IF F$SEARCH("[.KIT]DAYNAPORT$STARTUP.COM") .EQS. "" THEN -
      GOTO NO_STARTUP
$ IF F$SEARCH("[.KIT]DAYNAPORT$IVP.COM") .EQS. "" THEN GOTO NO_IVP
$ IF F$SEARCH("[.KIT]DAYNAPORT$INSTALL.TXT") .EQS. "" THEN -
      GOTO NO_INSTALL_TEXT
$ IF F$SEARCH("LICENSE.") .EQS. "" THEN GOTO NO_LICENSE
$
$ IF F$SEARCH("[.KIT]MATERIAL.DIR") .EQS. "" THEN -
      CREATE/DIRECTORY [.KIT.MATERIAL]
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ COPY/LOG DYDRIVER.EXE [.KIT.MATERIAL]DYDRIVER.EXE
$ IF .NOT. $STATUS THEN GOTO FAILED
$ COPY/LOG DP_VCI_CONTROL.EXE [.KIT.MATERIAL]DP_VCI_CONTROL.EXE
$ IF .NOT. $STATUS THEN GOTO FAILED
$ COPY/LOG [.KIT]DAYNAPORT$STARTUP.COM -
      [.KIT.MATERIAL]DAYNAPORT$STARTUP.COM
$ IF .NOT. $STATUS THEN GOTO FAILED
$ COPY/LOG [.KIT]DAYNAPORT$IVP.COM [.KIT.MATERIAL]DAYNAPORT$IVP.COM
$ IF .NOT. $STATUS THEN GOTO FAILED
$ COPY/LOG [.KIT]DAYNAPORT$INSTALL.TXT -
      [.KIT.MATERIAL]DAYNAPORT$INSTALL.TXT
$ IF .NOT. $STATUS THEN GOTO FAILED
$ COPY/LOG LICENSE. [.KIT.MATERIAL]DAYNAPORT$LICENSE.TXT
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ WRITE SYS$OUTPUT "Packaging CHATGPT56 VAXVMS DAYNAPORT V0.68 ..."
$ PRODUCT PACKAGE DAYNAPORT /PRODUCER=CHATGPT56 /BASE_SYSTEM=VAXVMS -
      /VERSION=V0.68 /FORMAT=SEQUENTIAL /LOG -
      /SOURCE=[.KIT]DAYNAPORT.PCSI$DESCRIPTION -
      /DESTINATION='PROJECT_ROOT' /MATERIAL=[.KIT.MATERIAL]
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ WRITE SYS$OUTPUT "DaynaPORT PCSI kit packaging completed."
$ DIRECTORY/SIZE/DATE CHATGPT56-VAXVMS-DAYNAPORT-*.PCSI
$ GOTO DONE
$
$ NO_DRIVER:
$ WRITE SYS$ERROR "DYDRIVER.EXE was not found; run @VMS_BUILD.COM."
$ GOTO MISSING
$ NO_VCI_CONTROL:
$ WRITE SYS$ERROR -
      "DP_VCI_CONTROL.EXE was not found; run @VMS_BUILD.COM."
$ GOTO MISSING
$ NO_DESCRIPTION:
$ WRITE SYS$ERROR "The PCSI product description file was not found."
$ GOTO MISSING
$ NO_TEXT:
$ WRITE SYS$ERROR "The PCSI product text file was not found."
$ GOTO MISSING
$ NO_STARTUP:
$ WRITE SYS$ERROR "DAYNAPORT$STARTUP.COM was not found."
$ GOTO MISSING
$ NO_IVP:
$ WRITE SYS$ERROR "DAYNAPORT$IVP.COM was not found."
$ GOTO MISSING
$ NO_INSTALL_TEXT:
$ WRITE SYS$ERROR "DAYNAPORT$INSTALL.TXT was not found."
$ GOTO MISSING
$ NO_LICENSE:
$ WRITE SYS$ERROR "LICENSE was not found."
$ GOTO MISSING
$ ABORTED:
$ WRITE SYS$ERROR "DaynaPORT PCSI packaging aborted."
$ GOTO MISSING
$
$ MISSING:
$ PACKAGE_STATUS = %X10000002
$ GOTO DONE
$ FAILED:
$ PACKAGE_STATUS = $STATUS
$ WRITE SYS$ERROR F$FAO("DaynaPORT PCSI packaging failed; status !XL", -
                        PACKAGE_STATUS)
$
$ DONE:
$ OLD_VERIFY = F$VERIFY(OLD_VERIFY)
$ EXIT PACKAGE_STATUS

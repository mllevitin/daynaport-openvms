$! Safe installation verification for the DaynaPORT PCSI kit.
$! It examines files and image structure only.  It never loads the driver.
$ SET NOON
$ ON CONTROL_Y THEN GOTO FAILED
$ OLD_VERIFY = F$VERIFY(0)
$ IVP_STATUS = 1
$ OLD_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ IVP_DEFAULT = F$PARSE(PROCEDURE,,,"DEVICE") + -
                F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'IVP_DEFAULT'
$ DRIVER_IMAGE = F$PARSE("[-.SYS$LDR]DYDRIVER.EXE")
$ MAC_INIT_IMAGE = F$PARSE("[-.SYS$STARTUP]DP_MAC_INIT.EXE")
$ VCI_CONTROL_IMAGE = F$PARSE("[-.SYS$STARTUP]DP_VCI_CONTROL.EXE")
$ STARTUP_FILE = F$PARSE("[-.SYS$STARTUP]DAYNAPORT$STARTUP.COM")
$ INSTALL_TEXT = F$PARSE("[-.SYSHLP]DAYNAPORT$INSTALL.TXT")
$ LICENSE_TEXT = F$PARSE("[-.SYSHLP]DAYNAPORT$LICENSE.TXT")
$
$ IF F$SEARCH(DRIVER_IMAGE) .EQS. "" THEN GOTO NO_DRIVER
$ IF F$SEARCH(MAC_INIT_IMAGE) .EQS. "" THEN GOTO NO_MAC_INIT
$ IF F$SEARCH(VCI_CONTROL_IMAGE) .EQS. "" THEN GOTO NO_VCI_CONTROL
$ IF F$SEARCH(STARTUP_FILE) .EQS. "" THEN GOTO NO_STARTUP
$ IF F$SEARCH(INSTALL_TEXT) .EQS. "" THEN GOTO NO_INSTALL_TEXT
$ IF F$SEARCH(LICENSE_TEXT) .EQS. "" THEN GOTO NO_LICENSE
$
$ ANALYZE/IMAGE/OUTPUT=NL: 'DRIVER_IMAGE'
$ IF .NOT. $STATUS THEN GOTO BAD_DRIVER
$ ANALYZE/IMAGE/OUTPUT=NL: 'MAC_INIT_IMAGE'
$ IF .NOT. $STATUS THEN GOTO BAD_MAC_INIT
$ ANALYZE/IMAGE/OUTPUT=NL: 'VCI_CONTROL_IMAGE'
$ IF .NOT. $STATUS THEN GOTO BAD_VCI_CONTROL
$
$ WRITE SYS$OUTPUT -
      "%DAYNAPORT-I-IVPPASS, installed files and image structures are valid"
$ WRITE SYS$OUTPUT -
      "%DAYNAPORT-I-NOTLOADED, the IVP did not load or connect the driver"
$ GOTO DONE
$
$ NO_DRIVER:
$ WRITE SYS$ERROR "%DAYNAPORT-E-NODRIVER, DYDRIVER.EXE was not found"
$ GOTO FAILED
$ NO_MAC_INIT:
$ WRITE SYS$ERROR "%DAYNAPORT-E-NOMACINIT, DP_MAC_INIT.EXE was not found"
$ GOTO FAILED
$ NO_VCI_CONTROL:
$ WRITE SYS$ERROR -
      "%DAYNAPORT-E-NOVCICTL, DP_VCI_CONTROL.EXE was not found"
$ GOTO FAILED
$ NO_STARTUP:
$ WRITE SYS$ERROR -
      "%DAYNAPORT-E-NOSTARTUP, DAYNAPORT$STARTUP.COM was not found"
$ GOTO FAILED
$ NO_INSTALL_TEXT:
$ WRITE SYS$ERROR -
      "%DAYNAPORT-E-NOINSTALLDOC, DAYNAPORT$INSTALL.TXT was not found"
$ GOTO FAILED
$ NO_LICENSE:
$ WRITE SYS$ERROR -
      "%DAYNAPORT-E-NOLICENSE, DAYNAPORT$LICENSE.TXT was not found"
$ GOTO FAILED
$ BAD_DRIVER:
$ WRITE SYS$ERROR "%DAYNAPORT-E-BADDRIVER, DYDRIVER.EXE image check failed"
$ GOTO FAILED
$ BAD_MAC_INIT:
$ WRITE SYS$ERROR -
      "%DAYNAPORT-E-BADMACINIT, DP_MAC_INIT.EXE image check failed"
$ GOTO FAILED
$ BAD_VCI_CONTROL:
$ WRITE SYS$ERROR -
      "%DAYNAPORT-E-BADVCICTL, DP_VCI_CONTROL.EXE image check failed"
$ GOTO FAILED
$
$ FAILED:
$ IVP_STATUS = %X10000002
$ DONE:
$ SET DEFAULT 'OLD_DEFAULT'
$ OLD_VERIFY = F$VERIFY(OLD_VERIFY)
$ EXIT IVP_STATUS
